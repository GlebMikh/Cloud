# Глебот целиком: и код бота, и рубрика, по которой он принимает решения.
#
# Копируется весь репозиторий, а не только bot/: классификатор читает
# .claude/skills/slack-watch/references/ и без них не стартует. Образ без
# рубрики выглядит собранным и падает на первом же сообщении.
FROM python:3.13-slim

WORKDIR /app

# Зависимости отдельным слоем: код меняется часто, список — почти никогда.
COPY bot/requirements.txt bot/requirements.txt
RUN pip install --no-cache-dir -r bot/requirements.txt

COPY . .

# База с ждущими карточками — единственное состояние, которое нельзя терять
# при выкате: карточка, съеденная рестартом, для владельца выглядит как
# пропавший баг. Каталог монтируется томом, см. docker-compose.yml.
ENV GLEBOT_DB=/data/glebot.sqlite3
VOLUME /data

# Socket Mode не принимает входящих соединений — порт открывать не нужно.
CMD ["python", "bot/app.py"]
