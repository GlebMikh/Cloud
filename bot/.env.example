# --- Slack ---------------------------------------------------------------
# xoxb-… Bot User OAuth Token: api.slack.com/apps → твоё приложение
#        → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# xapp-… App-Level Token со скоупом connections:write:
#        Basic Information → App-Level Tokens → Generate Token and Scopes
SLACK_APP_TOKEN=xapp-...
# Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=...

# --- Кого обслуживаем ----------------------------------------------------
OWNER_SLACK_ID=U0BK99FCH7F

# Каналы, где бот разбирает сообщения и предлагает ответы
WATCH_CHANNELS=C099240QR3N,C099GHLHAJV
# Каналы только для сводки: читаются, но в тред бот не пишет никогда
DIGEST_CHANNELS=C0AU59E1N9H

# --- Поведение -----------------------------------------------------------
# true — на прямой тег владельца бот отвечает мгновенно и сам,
#        не дожидаясь подтверждения. Остальные классы всё равно
#        проходят через одобрение. Начинать стоит с false.
AUTO_REPLY_ON_MENTION=false
# Реакция-метка «разобрано». Не бери эмодзи, которым пользуются люди:
# 👀 в этих каналах ставят живые коллеги.
MARKER_EMOJI=robot_face

# Сколько часов истории добрать при старте. Slack не переигрывает пропущенные
# события: всё, что произошло, пока процесс лежал, для него не существует.
# Ставить 0 стоит только если готов терять сообщения за время каждого деплоя.
BACKFILL_HOURS=24
# Время ежедневной сводки, ЧЧ:ММ по локальному времени хоста.
DIGEST_AT=09:30
# Через сколько часов без ответа карточка отменяется сама.
DRAFT_EXPIRY_HOURS=24

# --- Claude --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Модель классификатора. По умолчанию claude-opus-5.
# Дешевле и быстрее — claude-haiku-4-5, но качество разбора спорных
# сообщений заметно падает: см. bot/README.md, раздел про стоимость.
GLEBOT_MODEL=claude-opus-5

# --- Jira (опционально) --------------------------------------------------
# Без этих переменных реакция 🎫 просто запостит ответ и скажет,
# что Jira не настроена. Токен: id.atlassian.com → Security → API tokens
JIRA_BASE_URL=https://teamteh.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=TEAMDEV
JIRA_ISSUE_TYPE_BUG=Баг
