# --- Slack ---------------------------------------------------------------
# xoxb-… Bot User OAuth Token: api.slack.com/apps → твоё приложение
#        → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# xapp-… App-Level Token со скоупом connections:write:
#        Basic Information → App-Level Tokens → Generate Token and Scopes
SLACK_APP_TOKEN=xapp-...
# Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=...

# --- Кого обслуживаем ----------------------------------------------------
OWNER_SLACK_ID=U0BK99FCH7F

# Реагировать во всех каналах, где бот состоит участником (true) или только
# по списку WATCH_CHANNELS (false). В Socket Mode Slack и так шлёт события
# лишь из каналов-участников, поэтому true означает просто «добавил бота в
# канал — он там работает», без правки конфига.
WATCH_ALL_JOINED=true
# Список каналов на случай WATCH_ALL_JOINED=false. При true игнорируется.
WATCH_CHANNELS=C099240QR3N,C099GHLHAJV
# Каналы, куда бот не лезет, даже будучи участником: болталки, флуд, личное.
EXCLUDE_CHANNELS=
# Каналы только для сводки: читаются, но в тред бот не пишет никогда
DIGEST_CHANNELS=C0AU59E1N9H
# Песочница для проверки бота в одиночку. Единственное место, где бот
# разбирает сообщения САМОГО владельца: в рабочих каналах он их пропускает
# намеренно — он следит за тем, что пишут ему, а не за тем, что пишет он,
# и из-за этого проверить его без второго человека невозможно.
# Наблюдение включается автоматически, в WATCH_CHANNELS дублировать не надо.
TEST_CHANNELS=

# --- Поведение -----------------------------------------------------------
# Классы, на которые бот отвечает САМ, не дожидаясь одобрения:
# MENTION (тебя тегнули), BUG, TASK, QUESTION. Пусто — прежний режим,
# когда в канал не уходит ни слова без твоего «ок».
# После автоответа в личку приходит сводка: что ответил и как это
# отменить — ❌ убирает сказанное из треда, 🎫 заводит тикет,
# любой текст переписывает уже отправленное прямо в треде.
AUTOPOST_CLASSES=MENTION,BUG,TASK,QUESTION
# Пауза перед автоответом, секунды. Бот выбирает маршрут по состоянию треда
# на момент разбора, но живой коллега может откликнуться секундой позже.
# Пауза даёт людям фору: перед отправкой тред перечитывается заново, и если
# там кто-то появился, ответ в канал не уходит вовсе — приходит тебе в личку.
# 0 — отвечать сразу.
REPLY_DELAY_SECONDS=120
# Отложенный ответ, переживший перезапуск и старше этого возраста, в канал
# не уходит: реплика в разговоре двухчасовой давности выглядит нелепо.
STALE_DELAYED_MINUTES=30
# Ниже этой уверенности бот всё равно спрашивает: высокая | средняя | низкая.
# Ошибка автоответа видна не тебе, а всему каналу, поэтому порог не украшение.
AUTOPOST_MIN_CONFIDENCE=средняя
# Старая настройка, оставлена для совместимости: true означает то же самое,
# что AUTOPOST_CLASSES=MENTION.
AUTO_REPLY_ON_MENTION=false
# Реакция-метка «разобрано». Не бери эмодзи, которым пользуются люди:
# 👀 в этих каналах ставят живые коллеги.
MARKER_EMOJI=robot_face

# Сколько часов истории добрать при старте. Slack не переигрывает пропущенные
# события: всё, что произошло, пока процесс лежал, для него не существует.
# Ставить 0 стоит только если готов терять сообщения за время каждого деплоя.
BACKFILL_HOURS=24
# Время ежедневной сводки, ЧЧ:ММ по локальному времени хоста.
DIGEST_AT=09:30
# Через сколько часов без ответа карточка отменяется сама.
DRAFT_EXPIRY_HOURS=24

# --- Claude --------------------------------------------------------------
# Чем платим за разбор сообщений. Два варианта:
#   cli — через `claude -p` бинарником Claude Code, то есть по подписке,
#         которая и так оплачена. Ключ не нужен. Медленнее (десяток секунд
#         на сообщение) и работает только на машине, где Claude Code
#         установлен и залогинен.
#   api — прямой вызов Anthropic API: около секунды на сообщение, но это
#         отдельные деньги, к подписке Claude отношения не имеющие.
# Пусто — выбирается само: есть ANTHROPIC_API_KEY, значит api, нет — cli.
GLEBOT_BACKEND=cli

# Нужен только бэкенду api. Берётся на console.anthropic.com → API keys,
# требует пополненного баланса. Для cli строку можно оставить пустой.
ANTHROPIC_API_KEY=

# Путь к бинарнику Claude Code — только если он не в PATH и не в
# стандартном месте установки. Обычно определяется сам.
# CLAUDE_CLI=C:\Users\ты\AppData\Roaming\Claude\claude-code\2.1.241\claude.exe

# Модель классификатора. По умолчанию claude-opus-5.
# Дешевле и быстрее — claude-haiku-4-5, но качество разбора спорных
# сообщений заметно падает: см. bot/README.md, раздел про стоимость.
GLEBOT_MODEL=claude-opus-5

# Потолок разборов в час. На бэкенде cli каждый разбор — это сессия Claude
# Code, то есть кусок той же квоты, из которой ты работаешь сам: всплеск в
# канале не должен съедать рабочий день. 0 — без ограничения.
GLEBOT_MAX_CLASSIFICATIONS_PER_HOUR=30

# --- Jira (опционально) --------------------------------------------------
# Без этих переменных реакция 🎫 просто запостит ответ и скажет,
# что Jira не настроена. Токен: id.atlassian.com → Security → API tokens
JIRA_BASE_URL=https://teamteh.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=TEAMDEV
JIRA_ISSUE_TYPE_BUG=Баг
